{
  "env": {
    "browser": true,
    "commonjs": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "overrides": [
    {
      "files": ["client/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ],
  "globals": {
    "YT": "readonly",
    "io": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-empty": "warn",
    "no-useless-catch": "warn",
    "no-extra-semi": "error"
  }
}