# ============================================================================
# Bajao Bhai Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================================

# Server Configuration
PORT=3002
NODE_ENV=development

# ============================================================================
# Database Configuration
# ============================================================================
# Default: SQLite (recommended for development)
# For SQLite, no additional config needed - database auto-creates at data/

# For MySQL (optional):
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=your-password
# DB_NAME=bajao_bhai

# ============================================================================
# Redis Configuration (Optional but recommended for production)
# ============================================================================
# Used for queue caching and real-time data
# Leave empty to disable Redis caching
REDIS_URL=redis://127.0.0.1:6379

# ============================================================================
# Security & Authentication
# ============================================================================
# Generate secure random strings:
# Linux/Mac: openssl rand -hex 32
# Node.js: require('crypto').randomBytes(32).toString('hex')

# JWT secret for token signing/verification
TOKEN_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin secret for admin operations
ADMIN_SECRET=your-admin-secret-key-change-this-in-production

# ============================================================================
# External APIs
# ============================================================================
# YouTube API Key
# Get it from: https://console.cloud.google.com/apis/credentials
# Required for: YouTube search and playback
YOUTUBE_API_KEY=your-youtube-api-key

# ============================================================================
# Logging & Monitoring (Optional)
# ============================================================================
# LOG_LEVEL=info
# SENTRY_DSN=  # For error tracking